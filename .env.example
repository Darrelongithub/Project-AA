# ── Mode ────────────────────────────────────────────────────────────────────
# mock = no external calls (mock vision adapter, sends recorded not delivered).
# live = Gemini + Gmail for real (requires the credentials below).
MODE=mock

# ── Database & web ──────────────────────────────────────────────────────────
DB_PATH=./data/email-sorter.sqlite
PORT=8080

# Behind a reverse proxy that terminates TLS (nginx/Caddy/Cloudflare)?
# TRUST_PROXY=1 makes Express trust X-Forwarded-* (correct rate-limit buckets
# and client IPs). COOKIE_SECURE=1 marks session cookies Secure so browsers
# only send them over HTTPS — set BOTH whenever the console is served
# through HTTPS in production. Leave both unset on plain-HTTP LAN use.
#TRUST_PROXY=1
#COOKIE_SECURE=1

# ── Gemini (extraction fallback + watcher) ──────────────────────────────────
# Preferred: paste the key in the web console (Configuration → Document AI)
# — it is tested with one real call and goes live immediately, no restart.
# This env var is the CLI/bootstrap alternative.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Gmail (OAuth2 installed-app style: client id/secret + refresh token) ───
GMAIL_ADDRESS=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional: ingest only a specific Gmail label (e.g. INBOX). Default: all non-trash/non-spam mail.
GMAIL_LABEL=

# How many days back to look for all non-trash/non-spam mail on each ingest run.
# Default: 14. The Settings page also offers a one-off 30/90/365-day backfill.
INGEST_LOOKBACK_DAYS=14

# ── Factual automation switches (never decisions — receipts & status only) ──
AUTO_MISSING_DOCS_EMAILS=1
AUTO_STATUS_ANSWERS=1

# Set to 1 to skip the Tesseract OCR step (forces the Gemini fallback for scans)
DISABLE_OCR=0

# ── v3 (DB-backed, editable on the Settings page — defaults in src/config.ts) ─
# followup_ladder_days=3,7,10 · unanswered_target_hours=4 · retention_days=730
# automation_mode=auto|draft (draft-first: hold every automated reply)
# portal_otp_delivery=screen|email (screen shows the code in demo mode)

# Set to 0 to stop mirroring decision logs to logs/decisions.jsonl
LOG_TO_FILE=1

# ── Optional operational knobs (sane defaults; rarely needed) ──────────────
# Where npm run backup writes archives (default ./backups)
#BACKUP_DIR=./backups
# Where bundled intake data is resolved from (default: beside the installed
# package — never the working directory). Override only for portable installs.
#BUNDLED_DATA_DIR=
# Log verbosity: debug|info|warn|error (default info)
#LOG_LEVEL=info
# npm run retain: process every realm, not just the live one (or pass --all-realms)
#RETAIN_ALL_REALMS=1
# Gemini call timeout ms (default 60000) and daily call budget (default 100)
#GEMINI_TIMEOUT_MS=60000
#GEMINI_DAILY_BUDGET=100
# npm run simulate: persist the run to this throwaway file instead of :memory:
#SIM_DB_PATH=
# Whole-message cap in bytes; mail above this is parked, never downloaded (default 41943040 = 40 MiB)
#GMAIL_MAX_EMAIL_BYTES=41943040
# Tesseract OCR timeout ms (default 90000)
#OCR_TIMEOUT_MS=90000
# Full-page PDF raster fallback: max pages (default 10), render scale (default 2.2),
# max pixels per page (default 16000000 = 4000x4000), timeout ms (default 120000)
#RASTER_MAX_PAGES=10
#RASTER_SCALE=2.2
#RASTER_MAX_PIXELS=16000000
#RASTER_TIMEOUT_MS=120000
# npm run serve: also seed the opt-in demo organization #2 on boot
#SEED_DEMO_ORG=1
# npm run stress: how many synthetic cases to generate (default 1000)
#STRESS_N=1000
