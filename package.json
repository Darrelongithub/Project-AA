{
  "name": "email-sorter",
  "version": "0.1.0",
  "private": true,
  "description": "General-purpose document-intake console: tenant-configured case types, deterministic rules engine (Green/Orange/Red), tiered PDF extraction (pdfjs -> Tesseract -> Gemini), human queue for anything uncertain. Outcomes are recorded by people, never by the machine.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/extraction/pdfjs-esm.mjs','dist/src/extraction/pdfjs-esm.mjs')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx src/cli/simulate.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "queue": "tsx src/cli/queue.ts",
    "serve": "tsx src/cli/serve.ts",
    "escalate": "tsx src/cli/escalate.ts",
    "followups": "tsx src/cli/followups.ts",
    "retain": "tsx src/cli/retain.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "start": "node dist/src/cli/serve.js",
    "purge-mock": "tsx src/cli/purgeMock.ts",
    "seed:demo-org": "tsx src/cli/seedDemoOrg.ts",
    "stress": "tsx src/cli/stress.ts",
    "setup:linux": "bash scripts/setup-linux.sh"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^11.3.0",
    "canvas": "^3.2.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "googleapis": "^182.0.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "pdfjs-dist": {
      "canvas": "$canvas"
    }
  }
}
