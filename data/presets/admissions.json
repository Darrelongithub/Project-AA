      "flags": "i"
    },
    {
      "type": "application_form",
      "pattern": "application\\s+form|application\\s+for\\s+admission|admission\\s+application",
      "flags": "i"
    },
    {
      "type": "kcpe_cert",
      "pattern": "kenya\\s+certificate\\s+of\\s+primary\\s+education|\\bkcpe\\b",
      "flags": "i"
    },
    {
      "type": "birth_cert",
      "pattern": "certificate\\s+of\\s+birth|birth\\s+certificate|birth\\s+registration|certificate\\s+of\\s+live\\s+birth|live\\s+birth\\s+certificate|extract\\s+from\\s+the\\s+register\\s+of\\s+births|registration\\s+of\\s+birth|register\\s+of\\s+births|birth\\s+entry|births?\\s+and\\s+deaths\\s+registration",
      "flags": "i"
    },
